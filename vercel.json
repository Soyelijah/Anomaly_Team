{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "node_modules/tesseract.js-core/*.wasm"
    }
  },
  "rewrites": [
    {
      "source": "/assets/mu-original/(.*)",
      "destination": "https://causarex-one.vercel.app/assets/mu-original/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
